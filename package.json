{
  "name": "neon-fuse",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:server",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:server": "tsc -p server/tsconfig.json",
    "start:server": "node dist/realtime/server/index.js",
    "dev:server": "npm run build:server && node --env-file-if-exists=.env.local dist/realtime/server/index.js"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.3",
    "@discord/embedded-app-sdk": "^2.5.0",
    "better-auth": "1.7.3",
    "mongodb": "^6.16.0",
    "next": "^15.3.0",
    "phaser": "^3.88.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@better-auth/core": "1.7.3",
    "postcss": "8.5.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  }
}
