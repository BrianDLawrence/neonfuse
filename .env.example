MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/neon-fuse
MONGODB_DB=neon-fuse

# Better Auth requires a high-entropy secret of at least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Create an OAuth application at https://discord.com/developers/applications
# Local callback: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Public Discord application ID used by the Embedded App SDK.
NEXT_PUBLIC_DISCORD_CLIENT_ID=

# Two-player Discord matches. Keep both secrets server-side.
# Generate MULTIPLAYER_SECRET with: openssl rand -base64 48
MULTIPLAYER_SECRET=
DISCORD_BOT_TOKEN=

# Direct browser connection to the persistent realtime server. Discord Activities
# use the /multiplayer URL mapping instead.
NEXT_PUBLIC_MULTIPLAYER_URL=ws://localhost:3001/multiplayer

# Public support contacts rendered on /support. Configure both before listing
# Neon Fuse in Discord's App Directory.
SUPPORT_EMAIL=
DISCORD_SUPPORT_URL=
